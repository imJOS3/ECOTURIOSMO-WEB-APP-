PORT=3000

# PostgreSQL (local o Neon)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password
DB_NAME=ecoturismo

# En Neon / Render pon: DB_SSL=true
DB_SSL=false

# JWT (usa un string largo y aleatorio en producción)
JWT_SECRET=cambia_este_secreto_por_uno_largo

# Redis (opcional; solo si usas features que lo requieran)
# REDIS_URL=redis://localhost:6379

# Cloudinary (subida de imágenes)
CLOUDINARY_NAME=tu_cloud_name
CLOUDINARY_KEY=tu_api_key
CLOUDINARY_SECRET=tu_api_secret
